# Copia este archivo como `.env` y completa los valores.
# El archivo .env NO se versiona (está en .gitignore).

# Obligatorios
JWT_SECRET=genera_con_openssl_rand_base64_48
GEMINI_API_KEY=tu_api_key_de_gemini

# Opcionales (tienen valor por defecto en docker-compose.yml)
# SUPERADMIN_EMAIL=superadmin@pqrs.local
# SUPERADMIN_PASSWORD=admin123

# CORS adicional (separado por comas)
# CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173

# Envío de credenciales vía SMTP
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=tu_usuario
# SMTP_PASSWORD=tu_clave
# SMTP_SSL=true
# SMTP_FROM=no-reply@pqrs.local
# SMTP_FROM_NAME=PQRS SaaS

# Enlace al panel que va en los correos de credenciales
# PANEL_BASE_URL=http://localhost:8080
